{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Temporary experiment deployment — the TypeScript edition of the
  // vanilla re-implementation, served from a plain Cloudflare Worker with
  // static assets. Run `npm run build` before deploying.
  "name": "kody-video-typescript",
  "main": "dist-worker/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unknown paths serve index.html (client-side routing)…
    "not_found_handling": "single-page-application",
    // …but the API always reaches the worker.
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "typescript.kody.video", "custom_domain": true }]
}
