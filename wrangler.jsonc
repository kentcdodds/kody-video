{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Temporary experiment deployment — the vanilla re-implementation of
  // Kody Video, served from a plain Cloudflare Worker with static assets.
  "name": "kody-video-vanilla",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unknown paths serve index.html (client-side routing)…
    "not_found_handling": "single-page-application",
    // …but the API always reaches the worker.
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "vanilla.kody.video", "custom_domain": true }]
}
