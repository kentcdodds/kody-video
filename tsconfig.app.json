{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],

    /* The whole point of this edition: TypeScript that erases to the
       JavaScript the browser runs — no bundler, no transforms. */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,

    "rootDir": "src/app",
    "outDir": "public/js",

    /* Comments carry the device-quirk documentation — keep them. */
    "removeComments": false
  },
  "include": ["src/app"]
}
